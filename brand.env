# CHANTCH Remote branding, read by apply.py and make_workflow.py (README.md). KEY=VALUE, no quotes.

# Internal app name: config folders, Windows service and install folder, macOS bundle and executable
# (/Applications/<APP_NAME>.app/Contents/MacOS/<APP_NAME>), launchd labels <ORG>.<APP_NAME>_service.
# Letters and digits only: RustDesk's macOS code builds shell commands and launchd labels from it unquoted.
APP_NAME=CHANTCHRemote
# Shown where a space is safe: Windows file properties (ProductName/FileDescription), the MSI's product name stays APP_NAME.
DISPLAY_NAME=CHANTCH Remote
COMPANY=CHANTCH SDN BHD
# Prefix of launchd labels and the macOS config folder (upstream: com.carriez).
ORG=com.chantch
# macOS bundle identifier. Never change it once customers have installed: macOS ties Screen Recording/Accessibility to it.
BUNDLE_ID=com.chantch.remote

# The RustDesk server (deploy/rustdesk): public name, never the LAN IP.
ID_SERVER=remote.chantch.com
# /opt/chantch/rustdesk/data/id_ed25519.pub on the server (printed by install.sh). Public, not a secret.
RS_PUB_KEY=
